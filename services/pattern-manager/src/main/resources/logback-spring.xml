<?xml version="1.0" encoding="UTF-8"?>
<!-- Structured JSON logging via logstash-logback-encoder (Apache-2.0 / MIT). -->
<configuration>
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"pattern-manager"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
