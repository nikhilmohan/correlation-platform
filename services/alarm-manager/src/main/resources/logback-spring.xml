<?xml version="1.0" encoding="UTF-8"?>
<!-- Structured JSON logging. MDC carries traceId / alarmId / eventId where in scope. Log lines
     never carry PostgreSQL connection details or credentials. -->
<configuration>
  <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <includeMdcKeyName>traceId</includeMdcKeyName>
      <includeMdcKeyName>alarmId</includeMdcKeyName>
      <includeMdcKeyName>eventId</includeMdcKeyName>
      <customFields>{"service":"alarm-manager"}</customFields>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="JSON"/>
  </root>
</configuration>
