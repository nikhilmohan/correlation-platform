{
  "openapi": "3.1.0",
  "info": {
    "title": "ACP Simulator",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthModel"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics Endpoint",
        "operationId": "metrics_endpoint_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/labels": {
      "get": {
        "summary": "Labels",
        "operationId": "labels_labels_get",
        "parameters": [
          {
            "name": "scenarioId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Scenarioid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/GroundTruthLabelModel"
                      },
                      {
                        "$ref": "#/components/schemas/P3CascadeLabelModel"
                      }
                    ]
                  },
                  "title": "Response Labels Labels Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/labels/p3-summary": {
      "get": {
        "summary": "P3 Summary",
        "operationId": "p3_summary_labels_p3_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/P3RunSummaryModel"
                }
              }
            }
          }
        }
      }
    },
    "/labels/{scenario_id}": {
      "get": {
        "summary": "Label By Id",
        "operationId": "label_by_id_labels__scenario_id__get",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroundTruthLabelModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios": {
      "get": {
        "summary": "Scenarios",
        "operationId": "scenarios_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Scenarios Scenarios Get"
                }
              }
            }
          }
        }
      }
    },
    "/synth/run": {
      "post": {
        "summary": "Synth Run",
        "operationId": "synth_run_synth_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SynthRunRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SynthRunResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SynthConflictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid override parameter"
          }
        }
      }
    },
    "/synth/status": {
      "get": {
        "summary": "Synth Status",
        "operationId": "synth_status_synth_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SynthStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mine/run": {
      "post": {
        "summary": "Mine Run",
        "operationId": "mine_run_mine_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/MineRunRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MineRunResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MineConflictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid override parameter"
          }
        }
      }
    },
    "/mine/status": {
      "get": {
        "summary": "Mine Status",
        "operationId": "mine_status_mine_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MineStatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GroundTruthLabelModel": {
        "properties": {
          "scenarioId": {
            "type": "string",
            "title": "Scenarioid"
          },
          "scenarioType": {
            "type": "string",
            "title": "Scenariotype"
          },
          "rootCause": {
            "type": "string",
            "title": "Rootcause"
          },
          "rootCauseManagedObjectId": {
            "type": "string",
            "title": "Rootcausemanagedobjectid"
          },
          "rootCauseAlarmType": {
            "type": "string",
            "title": "Rootcausealarmtype"
          },
          "children": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Children"
          }
        },
        "type": "object",
        "required": [
          "scenarioId",
          "scenarioType",
          "rootCause",
          "rootCauseManagedObjectId",
          "rootCauseAlarmType",
          "children"
        ],
        "title": "GroundTruthLabelModel",
        "description": "Frozen /labels response shape."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthModel": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "kafka": {
            "type": "string",
            "title": "Kafka"
          },
          "run": {
            "type": "string",
            "title": "Run"
          }
        },
        "type": "object",
        "required": [
          "status",
          "kafka",
          "run"
        ],
        "title": "HealthModel"
      },
      "MineConflictResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": "a run is already in progress"
          },
          "runId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runid"
          }
        },
        "type": "object",
        "title": "MineConflictResponse",
        "description": "409 body: the already-active run's id (a mine or a synth run)."
      },
      "MineProgressModel": {
        "properties": {
          "alarmsEmitted": {
            "type": "integer",
            "title": "Alarmsemitted",
            "default": 0
          },
          "alarmsTotal": {
            "type": "integer",
            "title": "Alarmstotal",
            "default": 0
          },
          "alignedEmitted": {
            "type": "integer",
            "title": "Alignedemitted",
            "default": 0
          },
          "nonAlignedEmitted": {
            "type": "integer",
            "title": "Nonalignedemitted",
            "default": 0
          }
        },
        "type": "object",
        "title": "MineProgressModel"
      },
      "MineRunRequest": {
        "properties": {
          "scenarioInstances": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenarioinstances"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MineRunRequest",
        "description": "Optional P2 corpus knob overrides for a triggered run; absent fields use env/config."
      },
      "MineRunResponse": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "running"
          }
        },
        "type": "object",
        "required": [
          "runId"
        ],
        "title": "MineRunResponse",
        "description": "202 body: the accepted run's id + running status."
      },
      "MineStatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "runId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runid"
          },
          "progress": {
            "$ref": "#/components/schemas/MineProgressModel"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MineSummaryModel"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "progress"
        ],
        "title": "MineStatusResponse",
        "description": "Frozen ``GET /mine/status`` shape (top-level status is only idle/running)."
      },
      "MineSummaryModel": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "alarmsEmitted": {
            "type": "integer",
            "title": "Alarmsemitted"
          },
          "failureReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failurereason"
          },
          "startedAt": {
            "type": "string",
            "title": "Startedat"
          },
          "completedAt": {
            "type": "string",
            "title": "Completedat"
          }
        },
        "type": "object",
        "required": [
          "runId",
          "status",
          "alarmsEmitted",
          "startedAt",
          "completedAt"
        ],
        "title": "MineSummaryModel"
      },
      "P3CascadeLabelModel": {
        "properties": {
          "patternId": {
            "type": "string",
            "title": "Patternid"
          },
          "trailId": {
            "type": "string",
            "title": "Trailid"
          },
          "rootCauseAlarmId": {
            "type": "string",
            "title": "Rootcausealarmid"
          },
          "rootCauseAlarmType": {
            "type": "string",
            "title": "Rootcausealarmtype"
          },
          "childAlarmIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Childalarmids"
          },
          "scenarioType": {
            "type": "string",
            "title": "Scenariotype"
          },
          "instanceIndex": {
            "type": "integer",
            "title": "Instanceindex",
            "default": 1
          },
          "igpArea": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Igparea"
          }
        },
        "type": "object",
        "required": [
          "patternId",
          "trailId",
          "rootCauseAlarmId",
          "rootCauseAlarmType",
          "childAlarmIds",
          "scenarioType"
        ],
        "title": "P3CascadeLabelModel",
        "description": "Additive /labels record for P3 synth cascades (same endpoint, additive fields).\n\n``instanceIndex``/``igpArea`` are additive network-wide fields (AC 54); defaulted so existing\nsingle-trail consumers are unaffected."
      },
      "P3RunSummaryModel": {
        "properties": {
          "totalAlarms": {
            "type": "integer",
            "title": "Totalalarms"
          },
          "alignedAlarms": {
            "type": "integer",
            "title": "Alignedalarms"
          },
          "nonAlignedAlarms": {
            "type": "integer",
            "title": "Nonalignedalarms"
          },
          "alignedFraction": {
            "type": "number",
            "title": "Alignedfraction"
          },
          "distinctTrailsUsed": {
            "type": "integer",
            "title": "Distincttrailsused",
            "default": 0
          },
          "distinctAreasUsed": {
            "type": "integer",
            "title": "Distinctareasused",
            "default": 0
          },
          "shortfallCascades": {
            "type": "integer",
            "title": "Shortfallcascades",
            "default": 0
          },
          "enrichmentSafeCount": {
            "type": "integer",
            "title": "Enrichmentsafecount",
            "default": 0
          },
          "enrichmentConflictPatterns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Enrichmentconflictpatterns",
            "default": []
          },
          "alignedFractionEmitted": {
            "type": "number",
            "title": "Alignedfractionemitted",
            "default": 0.0
          },
          "expectedCorrelatedAlarms": {
            "type": "integer",
            "title": "Expectedcorrelatedalarms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "totalAlarms",
          "alignedAlarms",
          "nonAlignedAlarms",
          "alignedFraction"
        ],
        "title": "P3RunSummaryModel",
        "description": "/labels/p3-summary response \u2014 the run summary; the 60-70% KPI is directly computable.\n\nNetwork-wide adds the spread + enrichment fields (all additive, defaulted): distinct trails/\nareas used (AC 53), shortfall cascades (AC 55), enrichmentSafeCount + enrichmentConflictPatterns\n(AC 51/65), and the over-provisioned emitted fraction (AC 51)."
      },
      "ProgressModel": {
        "properties": {
          "alarmsEmitted": {
            "type": "integer",
            "title": "Alarmsemitted",
            "default": 0
          },
          "alarmsTotal": {
            "type": "integer",
            "title": "Alarmstotal",
            "default": 0
          },
          "alignedEmitted": {
            "type": "integer",
            "title": "Alignedemitted",
            "default": 0
          },
          "nonAlignedEmitted": {
            "type": "integer",
            "title": "Nonalignedemitted",
            "default": 0
          }
        },
        "type": "object",
        "title": "ProgressModel"
      },
      "SynthConflictResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": "a synth run is already in progress"
          },
          "runId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runid"
          }
        },
        "type": "object",
        "title": "SynthConflictResponse",
        "description": "409 body: the already-active run's id."
      },
      "SynthRunRequest": {
        "properties": {
          "target": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "totalAlarms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Totalalarms"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SynthRunRequest",
        "description": "Optional P3 knob overrides for a triggered run; absent fields use env/config defaults."
      },
      "SynthRunResponse": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "running"
          }
        },
        "type": "object",
        "required": [
          "runId"
        ],
        "title": "SynthRunResponse",
        "description": "202 body: the accepted run's id + running status."
      },
      "SynthStatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "runId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runid"
          },
          "progress": {
            "$ref": "#/components/schemas/ProgressModel"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SynthSummaryModel"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "progress"
        ],
        "title": "SynthStatusResponse",
        "description": "Frozen ``GET /synth/status`` shape (top-level status is only idle/running)."
      },
      "SynthSummaryModel": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "alarmsEmitted": {
            "type": "integer",
            "title": "Alarmsemitted"
          },
          "alignedFraction": {
            "type": "number",
            "title": "Alignedfraction"
          },
          "enrichmentSafeCount": {
            "type": "integer",
            "title": "Enrichmentsafecount"
          },
          "shortfallCascades": {
            "type": "integer",
            "title": "Shortfallcascades"
          },
          "enrichmentConflictPatterns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Enrichmentconflictpatterns",
            "default": []
          },
          "failureReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failurereason"
          },
          "startedAt": {
            "type": "string",
            "title": "Startedat"
          },
          "completedAt": {
            "type": "string",
            "title": "Completedat"
          }
        },
        "type": "object",
        "required": [
          "runId",
          "status",
          "alarmsEmitted",
          "alignedFraction",
          "enrichmentSafeCount",
          "shortfallCascades",
          "startedAt",
          "completedAt"
        ],
        "title": "SynthSummaryModel"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
