{
  "openapi": "3.1.0",
  "info": {
    "title": "ACP Simulator",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthModel"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics Endpoint",
        "operationId": "metrics_endpoint_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/labels": {
      "get": {
        "summary": "Labels",
        "operationId": "labels_labels_get",
        "parameters": [
          {
            "name": "scenarioId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Scenarioid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/GroundTruthLabelModel"
                      },
                      {
                        "$ref": "#/components/schemas/P3CascadeLabelModel"
                      }
                    ]
                  },
                  "title": "Response Labels Labels Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/labels/p3-summary": {
      "get": {
        "summary": "P3 Summary",
        "operationId": "p3_summary_labels_p3_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/P3RunSummaryModel"
                }
              }
            }
          }
        }
      }
    },
    "/labels/{scenario_id}": {
      "get": {
        "summary": "Label By Id",
        "operationId": "label_by_id_labels__scenario_id__get",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroundTruthLabelModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios": {
      "get": {
        "summary": "Scenarios",
        "operationId": "scenarios_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Scenarios Scenarios Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GroundTruthLabelModel": {
        "properties": {
          "scenarioId": {
            "type": "string",
            "title": "Scenarioid"
          },
          "scenarioType": {
            "type": "string",
            "title": "Scenariotype"
          },
          "rootCause": {
            "type": "string",
            "title": "Rootcause"
          },
          "rootCauseManagedObjectId": {
            "type": "string",
            "title": "Rootcausemanagedobjectid"
          },
          "rootCauseAlarmType": {
            "type": "string",
            "title": "Rootcausealarmtype"
          },
          "children": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Children"
          }
        },
        "type": "object",
        "required": [
          "scenarioId",
          "scenarioType",
          "rootCause",
          "rootCauseManagedObjectId",
          "rootCauseAlarmType",
          "children"
        ],
        "title": "GroundTruthLabelModel",
        "description": "Frozen /labels response shape."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthModel": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "kafka": {
            "type": "string",
            "title": "Kafka"
          },
          "run": {
            "type": "string",
            "title": "Run"
          }
        },
        "type": "object",
        "required": [
          "status",
          "kafka",
          "run"
        ],
        "title": "HealthModel"
      },
      "P3CascadeLabelModel": {
        "properties": {
          "patternId": {
            "type": "string",
            "title": "Patternid"
          },
          "trailId": {
            "type": "string",
            "title": "Trailid"
          },
          "rootCauseAlarmId": {
            "type": "string",
            "title": "Rootcausealarmid"
          },
          "rootCauseAlarmType": {
            "type": "string",
            "title": "Rootcausealarmtype"
          },
          "childAlarmIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Childalarmids"
          },
          "scenarioType": {
            "type": "string",
            "title": "Scenariotype"
          },
          "instanceIndex": {
            "type": "integer",
            "title": "Instanceindex",
            "default": 1
          },
          "igpArea": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Igparea"
          }
        },
        "type": "object",
        "required": [
          "patternId",
          "trailId",
          "rootCauseAlarmId",
          "rootCauseAlarmType",
          "childAlarmIds",
          "scenarioType"
        ],
        "title": "P3CascadeLabelModel",
        "description": "Additive /labels record for P3 synth cascades (same endpoint, additive fields).\n\n``instanceIndex``/``igpArea`` are additive network-wide fields (AC 54); defaulted so existing\nsingle-trail consumers are unaffected."
      },
      "P3RunSummaryModel": {
        "properties": {
          "totalAlarms": {
            "type": "integer",
            "title": "Totalalarms"
          },
          "alignedAlarms": {
            "type": "integer",
            "title": "Alignedalarms"
          },
          "nonAlignedAlarms": {
            "type": "integer",
            "title": "Nonalignedalarms"
          },
          "alignedFraction": {
            "type": "number",
            "title": "Alignedfraction"
          },
          "distinctTrailsUsed": {
            "type": "integer",
            "title": "Distincttrailsused",
            "default": 0
          },
          "distinctAreasUsed": {
            "type": "integer",
            "title": "Distinctareasused",
            "default": 0
          },
          "shortfallCascades": {
            "type": "integer",
            "title": "Shortfallcascades",
            "default": 0
          },
          "enrichmentSafeCount": {
            "type": "integer",
            "title": "Enrichmentsafecount",
            "default": 0
          },
          "enrichmentConflictPatterns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Enrichmentconflictpatterns",
            "default": []
          },
          "alignedFractionEmitted": {
            "type": "number",
            "title": "Alignedfractionemitted",
            "default": 0.0
          },
          "expectedCorrelatedAlarms": {
            "type": "integer",
            "title": "Expectedcorrelatedalarms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "totalAlarms",
          "alignedAlarms",
          "nonAlignedAlarms",
          "alignedFraction"
        ],
        "title": "P3RunSummaryModel",
        "description": "/labels/p3-summary response \u2014 the run summary; the 60-70% KPI is directly computable.\n\nNetwork-wide adds the spread + enrichment fields (all additive, defaulted): distinct trails/\nareas used (AC 53), shortfall cascades (AC 55), enrichmentSafeCount + enrichmentConflictPatterns\n(AC 51/65), and the over-provisioned emitted fraction (AC 51)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
