              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SnapshotListDto"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "ingestion-controller" ],
        "summary" : "Upload a topology snapshot file (synchronous lift; mints snapshotId).",
        "operationId" : "ingest",
        "parameters" : [ {
          "name" : "changeType",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Trace-Id",
          "in" : "header",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "string"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "422" : {
            "description" : "Schema- or semantic-invalid file.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502" : {
            "description" : "Domain vocabulary unavailable.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413" : {
            "description" : "Body exceeds the max snapshot size.",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "200" : {
