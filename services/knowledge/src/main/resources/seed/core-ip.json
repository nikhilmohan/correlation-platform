{
  "domain": "core-ip",
  "comment": "Core IP MVP domain pack. Loaded through the same validated write path (dogfood). Order matters: vocabularies before templates/fault-origins/trail-policy so cross-record reference validation passes.",
  "records": [
    {
      "recordType": "objectTypeVocabulary",
      "recordId": "core-ip/objectTypeVocabulary/default",
      "payload": {
        "objectTypes": ["Node", "LineCard", "Port", "Interface", "IPLink",
          "IGPAdjacency", "LSP", "VPNService", "FiberSpan", "SRLG", "Site"]
      }
    },
    {
      "recordType": "edgeRelationVocabulary",
      "recordId": "core-ip/edgeRelationVocabulary/default",
      "payload": {
        "relations": ["HOSTED_ON", "HOSTS", "TERMINATES", "RIDES_ON", "ADJACENCY_OVER",
          "TRAVERSES", "SERVES", "MEMBER_OF", "LOCATED_AT"]
      }
    },
    {
      "recordType": "alarmTypeVocabulary",
      "recordId": "core-ip/alarmTypeVocabulary/default",
      "payload": {
        "alarmTypes": [
          "LOS", "LOF", "OpticalPowerLow", "FiberCut", "FiberFault",
          "PortDown", "LineCardFault", "CRCErrors", "PortFlapping", "LinkBundleDegraded",
          "InterfaceDown", "InterfaceErrors", "IPLinkDown", "LinkDown",
          "ISISAdjacencyDown", "AdjDown", "OSPFAdjacencyDown", "BGPPeerDown", "RouteFlap", "LDPSessionDown",
          "LSPDown", "FRRSwitchover", "TETunnelDown",
          "VPNReachabilityLoss", "ReachabilityLoss", "ServiceDegraded",
          "Congestion", "QueueDrop", "HighLatency"]
      }
    },

    { "recordType": "faultOriginType", "recordId": "core-ip/faultOriginType/FiberSpan",
      "payload": { "objectType": "FiberSpan", "originAlarmType": "FiberCut",
        "description": "Optical fiber span; originates FiberCut and seeds the deepest cascade" } },
    { "recordType": "faultOriginType", "recordId": "core-ip/faultOriginType/LineCard",
      "payload": { "objectType": "LineCard", "originAlarmType": "LineCardFault",
        "description": "Line card; fans out to all hosted ports" } },
    { "recordType": "faultOriginType", "recordId": "core-ip/faultOriginType/Port",
      "payload": { "objectType": "Port", "originAlarmType": "PortDown",
        "description": "Single-port failure" } },
    { "recordType": "faultOriginType", "recordId": "core-ip/faultOriginType/Interface",
      "payload": { "objectType": "Interface", "originAlarmType": "InterfaceDown",
        "description": "L3 interface; originates InterfaceDown and cascades independently" } },
    { "recordType": "faultOriginType", "recordId": "core-ip/faultOriginType/Node",
      "payload": { "objectType": "Node", "originAlarmType": "LOS",
        "description": "Node-level optical loss-of-signal" } },
    { "recordType": "faultOriginType", "recordId": "core-ip/faultOriginType/IPLink",
      "payload": { "objectType": "IPLink", "originAlarmType": "IPLinkDown",
        "description": "IP link / bundle; routing-layer fault origin" } },
    { "recordType": "faultOriginType", "recordId": "core-ip/faultOriginType/LSP",
      "payload": { "objectType": "LSP", "originAlarmType": "LSPDown",
        "description": "MPLS LSP / TE-tunnel; service-layer fault origin" } },

    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/HOSTS",
      "payload": { "edgeType": "HOSTS",
        "trigger": { "objectType": "Port", "alarmType": "PortDown" },
        "effect": { "objectType": "Interface", "alarmType": "InterfaceDown" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 1,
        "description": "PortDown(Port) => InterfaceDown(each Interface on the port)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/TERMINATES",
      "payload": { "edgeType": "TERMINATES",
        "trigger": { "objectType": "Interface", "alarmType": "InterfaceDown" },
        "effect": { "objectType": "IPLink", "alarmType": "LinkDown" },
        "traversal": { "direction": "forward", "cardinality": "single-target" }, "ordering": 2,
        "description": "InterfaceDown(Interface) => LinkDown(its IPLink)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/RIDES_ON",
      "payload": { "edgeType": "RIDES_ON",
        "trigger": { "objectType": "FiberSpan", "alarmType": "FiberCut" },
        "effect": { "objectType": "IPLink", "alarmType": "LinkDown" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 2,
        "description": "fault(Fiber) => LinkDown(IPLink)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/ADJACENCY_OVER",
      "payload": { "edgeType": "ADJACENCY_OVER",
        "trigger": { "objectType": "Interface", "alarmType": "InterfaceDown" },
        "effect": { "objectType": "IGPAdjacency", "alarmType": "AdjDown" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 3,
        "description": "InterfaceDown(Interface) => AdjDown(IGPAdjacency on that interface)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/TRAVERSES",
      "payload": { "edgeType": "TRAVERSES",
        "trigger": { "objectType": "IPLink", "alarmType": "LinkDown" },
        "effect": { "objectType": "LSP", "alarmType": "LSPDown" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 4,
        "description": "LinkDown(IPLink) => LSPDown(LSP head-end)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/SERVES",
      "payload": { "edgeType": "SERVES",
        "trigger": { "objectType": "LSP", "alarmType": "LSPDown" },
        "effect": { "objectType": "VPNService", "alarmType": "ReachabilityLoss" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 5,
        "description": "LSPDown(LSP) => ReachabilityLoss(VPN)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/MEMBER_OF",
      "payload": { "edgeType": "MEMBER_OF",
        "trigger": { "objectType": "IPLink", "alarmType": "LinkDown" },
        "effect": { "objectType": "IPLink", "alarmType": "LinkDown" },
        "traversal": { "direction": "forward", "cardinality": "co-failure-group" }, "ordering": 2,
        "description": "co-failure grouping (SRLG fate sharing)" } },

    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/HOSTED_ON#lcfault",
      "payload": { "edgeType": "HOSTED_ON",
        "trigger": { "objectType": "LineCard", "alarmType": "LineCardFault" },
        "effect": { "objectType": "Port", "alarmType": "PortDown" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 0,
        "description": "LineCardFault(LineCard) => PortDown(each hosted Port)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/RIDES_ON#los",
      "payload": { "edgeType": "RIDES_ON",
        "trigger": { "objectType": "FiberSpan", "alarmType": "FiberCut" },
        "effect": { "objectType": "Port", "alarmType": "LOS" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 1,
        "description": "FiberCut(FiberSpan) => LOS(each lit Port)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/RIDES_ON#lof",
      "payload": { "edgeType": "RIDES_ON",
        "trigger": { "objectType": "FiberSpan", "alarmType": "FiberCut" },
        "effect": { "objectType": "Port", "alarmType": "LOF" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 1,
        "description": "FiberCut(FiberSpan) => LOF(each lit Port)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/RIDES_ON#optpwr",
      "payload": { "edgeType": "RIDES_ON",
        "trigger": { "objectType": "FiberSpan", "alarmType": "FiberCut" },
        "effect": { "objectType": "Port", "alarmType": "OpticalPowerLow" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 1,
        "description": "FiberCut(FiberSpan) => OpticalPowerLow(each lit Port)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/HOSTS#crc",
      "payload": { "edgeType": "HOSTS",
        "trigger": { "objectType": "Port", "alarmType": "PortDown" },
        "effect": { "objectType": "Interface", "alarmType": "CRCErrors" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 1,
        "description": "PortDown(Port) => CRCErrors(each Interface, transient pre-down errors)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/HOSTS#flap",
      "payload": { "edgeType": "HOSTS",
        "trigger": { "objectType": "Port", "alarmType": "PortDown" },
        "effect": { "objectType": "Interface", "alarmType": "InterfaceErrors" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 1,
        "description": "PortDown(Port) => InterfaceErrors(each Interface)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/HOSTED_ON#portflap",
      "payload": { "edgeType": "HOSTED_ON",
        "trigger": { "objectType": "LineCard", "alarmType": "LineCardFault" },
        "effect": { "objectType": "Port", "alarmType": "PortFlapping" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 0,
        "description": "LineCardFault(LineCard) => PortFlapping(each Port, pre-down instability)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/TERMINATES#iplink",
      "payload": { "edgeType": "TERMINATES",
        "trigger": { "objectType": "Interface", "alarmType": "InterfaceDown" },
        "effect": { "objectType": "IPLink", "alarmType": "IPLinkDown" },
        "traversal": { "direction": "forward", "cardinality": "single-target" }, "ordering": 2,
        "description": "InterfaceDown(Interface) => IPLinkDown(its IPLink, routing-visible)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/MEMBER_OF#bundle",
      "payload": { "edgeType": "MEMBER_OF",
        "trigger": { "objectType": "IPLink", "alarmType": "LinkDown" },
        "effect": { "objectType": "IPLink", "alarmType": "LinkBundleDegraded" },
        "traversal": { "direction": "forward", "cardinality": "co-failure-group" }, "ordering": 2,
        "description": "LinkDown(member) => LinkBundleDegraded(bundle, partial member loss)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/ADJACENCY_OVER#isis",
      "payload": { "edgeType": "ADJACENCY_OVER",
        "trigger": { "objectType": "Interface", "alarmType": "InterfaceDown" },
        "effect": { "objectType": "IGPAdjacency", "alarmType": "ISISAdjacencyDown" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 3,
        "description": "InterfaceDown(Interface) => ISISAdjacencyDown(IS-IS adjacency)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/ADJACENCY_OVER#ospf",
      "payload": { "edgeType": "ADJACENCY_OVER",
        "trigger": { "objectType": "Interface", "alarmType": "InterfaceDown" },
        "effect": { "objectType": "IGPAdjacency", "alarmType": "OSPFAdjacencyDown" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 3,
        "description": "InterfaceDown(Interface) => OSPFAdjacencyDown(OSPF adjacency)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/ADJACENCY_OVER#bgp",
      "payload": { "edgeType": "ADJACENCY_OVER",
        "trigger": { "objectType": "IGPAdjacency", "alarmType": "AdjDown" },
        "effect": { "objectType": "IGPAdjacency", "alarmType": "BGPPeerDown" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 4,
        "description": "AdjDown(IGP) => BGPPeerDown(BGP session loses IGP next-hop)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/ADJACENCY_OVER#route",
      "payload": { "edgeType": "ADJACENCY_OVER",
        "trigger": { "objectType": "IGPAdjacency", "alarmType": "AdjDown" },
        "effect": { "objectType": "IGPAdjacency", "alarmType": "RouteFlap" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 4,
        "description": "AdjDown(IGP) => RouteFlap(reconvergence churn)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/TRAVERSES#frr",
      "payload": { "edgeType": "TRAVERSES",
        "trigger": { "objectType": "IPLink", "alarmType": "LinkDown" },
        "effect": { "objectType": "LSP", "alarmType": "FRRSwitchover" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 5,
        "description": "LinkDown(IPLink) => FRRSwitchover(protected LSP fast-reroute)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/TRAVERSES#te",
      "payload": { "edgeType": "TRAVERSES",
        "trigger": { "objectType": "IPLink", "alarmType": "LinkDown" },
        "effect": { "objectType": "LSP", "alarmType": "TETunnelDown" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 5,
        "description": "LinkDown(IPLink) => TETunnelDown(unprotected TE tunnel)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/SERVES#vpn",
      "payload": { "edgeType": "SERVES",
        "trigger": { "objectType": "LSP", "alarmType": "LSPDown" },
        "effect": { "objectType": "VPNService", "alarmType": "VPNReachabilityLoss" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 6,
        "description": "LSPDown(LSP) => VPNReachabilityLoss(VPN, explicit VPN-scoped loss)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/SERVES#degraded",
      "payload": { "edgeType": "SERVES",
        "trigger": { "objectType": "LSP", "alarmType": "LSPDown" },
        "effect": { "objectType": "VPNService", "alarmType": "ServiceDegraded" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 6,
        "description": "LSPDown(LSP) => ServiceDegraded(VPN, partial-path degradation)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/SERVES#congestion",
      "payload": { "edgeType": "SERVES",
        "trigger": { "objectType": "LSP", "alarmType": "FRRSwitchover" },
        "effect": { "objectType": "VPNService", "alarmType": "Congestion" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 7,
        "description": "FRRSwitchover(LSP) => Congestion(VPN, backup path oversubscribed)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/SERVES#qdrop",
      "payload": { "edgeType": "SERVES",
        "trigger": { "objectType": "LSP", "alarmType": "FRRSwitchover" },
        "effect": { "objectType": "VPNService", "alarmType": "QueueDrop" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 7,
        "description": "FRRSwitchover(LSP) => QueueDrop(VPN, congestion drops)" } },
    { "recordType": "propagationTemplate", "recordId": "core-ip/propagationTemplate/SERVES#latency",
      "payload": { "edgeType": "SERVES",
        "trigger": { "objectType": "LSP", "alarmType": "FRRSwitchover" },
        "effect": { "objectType": "VPNService", "alarmType": "HighLatency" },
        "traversal": { "direction": "forward", "cardinality": "each-target" }, "ordering": 7,
        "description": "FRRSwitchover(LSP) => HighLatency(VPN, longer backup path)" } },

    { "recordType": "trailPolicy", "recordId": "core-ip/trailPolicy/default",
      "payload": {
        "closureEdgeTypes": ["HOSTED_ON", "HOSTS", "TERMINATES", "RIDES_ON", "ADJACENCY_OVER",
          "TRAVERSES", "SERVES"],
        "boundary": { "type": "igp-area", "attributeKey": "igpArea" },
        "srlgRule": { "mode": "union-members", "srlgEdgeType": "MEMBER_OF" } } },

    { "recordType": "modelParams", "recordId": "core-ip/modelParams/noise-filter",
      "payload": { "paramSet": "noise-filter", "params": [
        { "key": "dbscan.epsilon", "type": "number", "value": 0.5, "min": 0.0, "max": 100.0 },
        { "key": "dbscan.minSamples", "type": "integer", "value": 3, "min": 1, "max": 1000 },
        { "key": "window.sizeSeconds", "type": "integer", "value": 60, "min": 1, "max": 86400, "unit": "s" },
        { "key": "feature.attributeKeys", "type": "object", "value": ["equipmentType", "vendor", "model"] },
        { "key": "feature.hopDistance.enabled", "type": "boolean", "value": false },
        { "key": "feature.objectTypeLayer.enabled", "type": "boolean", "value": true } ] } },
    { "recordType": "modelParams", "recordId": "core-ip/modelParams/pattern-miner",
      "payload": { "paramSet": "pattern-miner", "params": [
        { "key": "prefixspan.minSupport", "type": "number", "value": 0.3, "min": 0.0, "max": 1.0 },
        { "key": "prefixspan.maxPatternLength", "type": "integer", "value": 10, "min": 1, "max": 100 },
        { "key": "prefixspan.maxSequenceCount", "type": "integer", "value": 1000, "min": 1, "max": 1000000 },
        { "key": "window.adaptive.baseGapSeconds", "type": "number", "value": 5.0, "min": 0.001, "max": 3600.0, "unit": "s" },
        { "key": "window.adaptive.gapMultiplier", "type": "number", "value": 3.0, "min": 1.0, "max": 100.0 },
        { "key": "window.adaptive.tempoPercentile", "type": "number", "value": 95.0, "min": 1.0, "max": 100.0 },
        { "key": "window.adaptive.profiles", "type": "object", "value": { "fast": 0.5, "slow": 30.0, "default": 5.0 } },
        { "key": "codebookVersion", "type": "string", "value": "current" } ] } },
    { "recordType": "modelParams", "recordId": "core-ip/modelParams/correlation-engine",
      "payload": { "paramSet": "correlation-engine", "params": [
        { "key": "match.partialMatchTolerance", "type": "integer", "value": 1, "min": 0, "max": 100 },
        { "key": "codebook.missingPenalty", "type": "number", "value": 1.0, "min": 0.0, "max": 100.0 },
        { "key": "codebook.spuriousPenalty", "type": "number", "value": 2.0, "min": 0.0, "max": 100.0 },
        { "key": "codebook.scoreFloor", "type": "number", "value": 0.5, "min": 0.0, "max": 1.0 },
        { "key": "conflict.weights.specificity", "type": "number", "value": 1.0, "min": 0.0, "max": 100.0 },
        { "key": "conflict.weights.confidence", "type": "number", "value": 0.5, "min": 0.0, "max": 100.0 } ] } },
    { "recordType": "modelParams", "recordId": "core-ip/modelParams/pattern-manager",
      "payload": { "paramSet": "pattern-manager", "params": [
        { "key": "structural.maxHops", "type": "integer", "value": 4, "min": 1, "max": 64 },
        { "key": "structural.strictness", "type": "string", "value": "lenient" },
        { "key": "structural.flagVsReject", "type": "string", "value": "flag" },
        { "key": "rca.dependencyOrderingWeight", "type": "number", "value": 1.0, "min": 0.0, "max": 100.0 },
        { "key": "rca.timestampWeight", "type": "number", "value": 0.5, "min": 0.0, "max": 100.0 },
        { "key": "reconciliation.overlapThreshold", "type": "number", "value": 0.5, "min": 0.0, "max": 1.0 } ] } },

    { "recordType": "attributeCatalogue", "recordId": "core-ip/attributeCatalogue/default",
      "payload": {
        "deviceKeys": [
          { "key": "vendor", "valueForm": "string" },
          { "key": "model", "valueForm": "string" },
          { "key": "equipmentType", "valueForm": "enum", "allowed": ["router", "switch", "olt", "dwdm"] },
          { "key": "role", "valueForm": "string" },
          { "key": "capacity", "valueForm": "number" },
          { "key": "igpArea", "valueForm": "string",
            "description": "IGP area a Node (and the Interfaces it hosts) belongs to, e.g. area-0, area-1. Trail-policy boundary key (trailPolicy/default boundary.attributeKey). Applicable to Node and Interface." } ],
        "connectionKeys": [
          { "key": "linkType", "valueForm": "string" },
          { "key": "capacity", "valueForm": "number" },
          { "key": "protectionRole", "valueForm": "enum", "allowed": ["working", "protect"] } ] } }
  ]
}
