{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp/knowledge/recordmodel/modelParams.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["paramSet", "params"],
  "properties": {
    "paramSet": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" },
    "params": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type", "value"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]*$" },
          "type": { "enum": ["number", "integer", "string", "boolean", "object"] },
          "value": {},
          "min": { "type": "number" },
          "max": { "type": "number" },
          "unit": { "type": "string" }
        }
      }
    }
  }
}
