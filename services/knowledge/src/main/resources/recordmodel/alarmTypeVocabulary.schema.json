{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp/knowledge/recordmodel/alarmTypeVocabulary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["alarmTypes"],
  "properties": {
    "alarmTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
    }
  }
}
